        "questions": {"type": "array", "items": {"type": "object", "required": ["question", "why", "answer_hint"],
          "properties": {"question": {"type": "string"}, "why": {"type": "string"}, "answer_hint": {"type": "string"}},
          "additionalProperties": false}},
        "tips": {"type": "array", "items": {"type": "string"}},
        "questions_to_ask": {"type": "array", "items": {"type": "string"}}
